{
  "name": "state-not-fate-public-tests",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "node scripts/static-server.mjs",
    "test": "playwright test",
    "test:public": "playwright test tests/public",
    "test:beta": "playwright test tests/public --config=playwright.beta.config.ts",
    "test:production": "playwright test tests/public --config=playwright.production.config.ts",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "check:links": "node scripts/check-links.mjs",
    "audit:privacy": "node scripts/privacy-audit.mjs",
    "ci": "npm run test:unit && npm run test:integration && npm test",
    "health": "node scripts/local-health-check.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.9.3"
  }
}
